<Project>
  <!-- 이 파일을 Directory.Build.local.props 로 복사해서 값을 채운다(그 파일은 git 이 무시한다).
       GitHub → Settings → Developer settings → OAuth Apps → New OAuth App 으로 앱을 만들고 "Enable Device Flow" 를 켠 뒤,
       그 앱의 "Optional features → Token expiration" 은 Opt-out 한다(켜져 있으면 토큰이 8시간 뒤 만료된다).
       Client ID 는 비밀이 아니다. Client Secret 은 필요 없고 넣지도 않는다. -->
  <PropertyGroup>
    <AppGitHubClientId>Ov23li…여기에 Client ID</AppGitHubClientId>
  </PropertyGroup>
</Project>
